NODE_ENV=development
HOST=127.0.0.1
PORT=4174

# Production persistence. Railway may provide DATABASE_URL automatically.
KUDIROLL_AUTH_BACKEND=file
KUDIROLL_ACCOUNT_BACKEND=file
KUDIROLL_DATABASE_URL=
KUDIROLL_DATABASE_POOL_SIZE=5
KUDIROLL_DATA_ENCRYPTION_KEY=

# Exact first-party origin and WebAuthn relying party.
KUDIRAIL_ALLOWED_ORIGINS=http://localhost:4173
KUDIROLL_WEBAUTHN_ORIGIN=http://localhost:4173
KUDIROLL_WEBAUTHN_RP_ID=localhost

# Email OTP delivery. Use a separate random code secret of at least 32 characters.
RESEND_API_KEY=
KUDIROLL_EMAIL_FROM=KudiRoll <security@example.com>
KUDIROLL_EMAIL_CODE_SECRET=

# Starknet Mainnet verification and STRK20 pool-event checks.
STARKNET_RPC_URL=
STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Paycrest remains disabled until its Starknet settlement lifecycle is certified.
PAYCREST_API_KEY=
PAYCREST_API_BASE=https://api.paycrest.io
PAYCREST_REFERENCE_PREFIX=kudiroll-
PAYCREST_REQUEST_TIMEOUT_MS=15000
PHASE0_LIVE_ORDER_ENABLED=false
PHASE0_MAX_NGN=5000

KUDIRAIL_RELEASE_SHA=development
